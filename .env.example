# GISAP Environment Configuration Template

# S3 Object Storage (MinIO Local / AWS Cloud)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniopassword
S3_BUCKET_RAW=raw-sequences
S3_BUCKET_INTERMEDIATES=intermediates
S3_BUCKET_RESULTS=results
S3_BUCKET_REFERENCE=reference-dbs
S3_SECURE=false

# Control Metadata Database (PostgreSQL 16)
DATABASE_URL=postgresql://gisap:gisap_password@localhost:5432/gisap_metadata
ASYNC_DATABASE_URL=postgresql+asyncpg://gisap:gisap_password@localhost:5432/gisap_metadata
SQLITE_DATABASE_URL=sqlite:///./gisap_metadata.db

# Caching & Coordination (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Security & Multi-Tenancy
JWT_SECRET=gisap_development_secret_key_change_in_production_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEFAULT_TENANT_ID=ssit-tumakuru

# External Research (Optional)
FIRECRAWL_API_KEY=

# AI-Assisted Annotation — Gemini Free Tier (Optional)
# Get a free key at: https://aistudio.google.com/apikey
# When set, enables POST /api/v1/research/ai-annotate
# All outputs are tagged evidence_type=ai_suggested_hypothesis
GEMINI_API_KEY=AQ.Ab8RN6JAJBeZ1KDur1DT2PF9TnzCqouK2YRZkP7xLgaf2ryrsw
GEMINI_MODEL=gemini-1.5-flash
