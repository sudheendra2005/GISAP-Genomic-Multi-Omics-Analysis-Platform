manifest {
    name = 'GISAP-DNA-Alpha'
    author = 'GISAP Bioinformatics Team'
    version = '1.0.0-alpha'
    description = 'Scalable DNA Ingestion, Streaming Validation, BLAST Alignment and Parquet Indexing'
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.executor = 'local'
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
        process.queue = 'bio-compute'
        process.clusterOptions = '--qos=normal'
    }
}

process {
    withName: 'STREAM_VALIDATE' {
        cpus = 1
        memory = '512.MB'
    }
    withName: 'RUN_BLAST' {
        cpus = 2
        memory = '2.GB'
    }
    withName: 'CONVERT_PARQUET' {
        cpus = 1
        memory = '1.GB'
    }
    withName: 'RECORD_PROVENANCE' {
        cpus = 1
        memory = '512.MB'
    }
}
