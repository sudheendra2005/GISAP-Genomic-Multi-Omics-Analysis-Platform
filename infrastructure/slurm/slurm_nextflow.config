process {
    executor = 'slurm'
    queue = 'bio-compute'
    clusterOptions = '--qos=normal'

    withName: 'STREAM_VALIDATE' {
        cpus = 2
        memory = '4.GB'
        time = '1h'
    }

    withName: 'RUN_BLAST' {
        cpus = 16
        memory = '32.GB'
        time = '6h'
    }

    withName: 'CONVERT_PARQUET' {
        cpus = 4
        memory = '8.GB'
        time = '2h'
    }

    withName: 'RECORD_PROVENANCE' {
        cpus = 1
        memory = '2.GB'
        time = '30m'
    }
}

apptainer {
    enabled = true
    autoMounts = true
    runOptions = '--bind /scratch:/scratch'
}
